# ──────────────────────────────────────────────────────────────
# Plantilla de variables de entorno para posib.dev
# Copia este archivo a .env.local (desarrollo) y configura los
# valores reales en el panel de Vercel para producción.
# NUNCA pongas secretos reales en este archivo: está versionado.
# ──────────────────────────────────────────────────────────────

# ── Clerk (autenticación) ─────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<tu-clerk-publishable-key>
CLERK_SECRET_KEY=<tu-clerk-secret-key>
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk 6.x: usar *_FALLBACK_REDIRECT_URL (las antiguas *_AFTER_SIGN_IN_URL no surten efecto)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── Aplicación ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://posib.dev
NEXT_PUBLIC_URL=https://posib.dev

# ── Cloudflare Workers API ────────────────────────────────────
NEXT_PUBLIC_CLOUDFLARE_API_URL=https://tienda-pos-api.julii1295.workers.dev

# ── ePayco (pasarela de pago) ─────────────────────────────────
EPAYCO_P_CUST_ID_CLIENTE=xxxxxxx
NEXT_PUBLIC_EPAYCO_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
EPAYCO_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
EPAYCO_P_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_EPAYCO_ENV=

# ── Cloudinary (hosting de imágenes) ──────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=xxxxxxxx
NEXT_PUBLIC_CLOUDINARY_API_KEY=xxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Ads (seguimiento de conversiones) ──────────────────
# La etiqueta base (AW-17995545981) está en app/layout.tsx.
# Este es solo el "label" de la acción de conversión "Registro":
# créala en Google Ads por método "etiqueta de Google Ads" y copia
# aquí lo que va después de la barra en el send_to (AW-17995545981/XXXX).
# Si se deja vacío, no se envía la conversión (comportamiento seguro).
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=

# ── Otros servicios ───────────────────────────────────────────
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=<tu-resend-api-key>
CRON_SECRET=genera-un-valor-aleatorio-largo

# Facturación electrónica DIAN: clave maestra que cifra las firmas digitales (.p12)
# y los PIN de las tiendas. Solo en Next/Vercel, NUNCA en el Worker.
# Generar con: openssl rand -base64 32   (si se pierde, hay que volver a subir las firmas)
FE_MASTER_KEY=

# Pruebas E2E con Playwright (pnpm e2e) — solo instancia de desarrollo de Clerk
# Correo de un usuario existente en Clerk dev (inicia sesión por ticket, sin contraseña)
E2E_CLERK_USER_EMAIL=
# Nombre exacto de un producto con stock que se vende por paquete (la prueba lo vende y luego borra la venta)
E2E_PRODUCT=
