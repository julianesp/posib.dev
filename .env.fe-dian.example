# Copia este archivo a .env.fe-dian (NO se sube a git) y llena los datos.
# Datos del facturador (la tienda) tal como aparecen en el RUT.
FE_NIT=
FE_DV=
FE_TIPO_PERSONA=2            # 1 = persona jurídica, 2 = persona natural
FE_RAZON_SOCIAL=
FE_NOMBRE_COMERCIAL=
FE_RESPONSABILIDADES=R-99-PN # responsabilidades del RUT separadas por ; (ej. O-13;O-15)
FE_TRIBUTO=ZZ                # 01 = responsable de IVA, ZZ = no aplica
FE_MUNICIPIO_CODIGO=86001    # código DANE
FE_MUNICIPIO=Mocoa
FE_DEPARTAMENTO=Putumayo
FE_DEPARTAMENTO_CODIGO=86
FE_DIRECCION=
FE_TELEFONO=
FE_CORREO=

# Portal DIAN → Habilitación → Software propio (al registrar el software).
FE_SOFTWARE_ID=
FE_PIN=
FE_TEST_SET_ID=

# Certificado de firma digital (.p12 de una entidad ONAC, a nombre de la tienda).
FE_P12=/ruta/al/certificado.p12
FE_P12_CLAVE=

# Cantidad de documentos que pide el set (la muestra el portal).
FE_FACTURAS=8
FE_NOTAS_CREDITO=1
FE_NOTAS_DEBITO=1
